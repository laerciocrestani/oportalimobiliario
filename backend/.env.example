APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.localhost:8000
FRONTEND_BROKER_URL=http://corretor.localhost:5173

CORS_ALLOWED_ORIGINS=http://construtora.localhost:5173,http://corretor.localhost:5173,http://admin.localhost:5173,http://www.localhost:4321
SANCTUM_STATEFUL_DOMAINS=construtora.localhost,corretor.localhost,admin.localhost,www.localhost,api.localhost
PUBLIC_SITE_URL=http://www.localhost:4321

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=oportalimobiliario
DB_USERNAME=oportalimobiliario
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_BROKER_INVITE=broker_invite_start
WHATSAPP_DECLINE_BUTTON_TEXT="Recusar"

# Descritivo do wizard (REQ-WIZ-014). Construtora não escolhe o provedor.
OPIM_LLM_PROVIDER=gemini
OPIM_LLM_TIMEOUT=8
GEMINI_API_KEY=
OPIM_GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPIM_OPENAI_MODEL=gpt-4o-mini

# INCC-M helper (REQ-WIZ-012). Série 7456 no SGS é variação %; o job só grava número-índice.
OPIM_INCC_BCB_SERIES_ID=7456
OPIM_INCC_BCB_TIMEOUT=5
