---
import type { PublicBuilderCatalogItem } from '@/lib/api'
import { browserMediaUrl, portfolioLine } from '@/lib/modelo'

interface Props {
  builder: PublicBuilderCatalogItem
}

const { builder } = Astro.props
const logoUrl = builder.logo_url ? browserMediaUrl(builder.logo_url) : null
const initials = builder.name
  .trim()
  .split(/\s+/)
  .filter((word) => word.length > 0)
  .slice(0, 2)
  .map((word) => word.charAt(0))
  .join('')
  .toLocaleUpperCase('pt-BR')
const stock = portfolioLine(builder.available_units_count, builder.buildings_count)
---

<li>
  <a class="modelo-builder-card" href={`/modelo/construtoras/${encodeURIComponent(builder.slug)}`}>
    <span class="modelo-builder-card__logo">
      {
        logoUrl ? (
          <img src={logoUrl} alt="" width="72" height="72" />
        ) : (
          <span aria-hidden="true">{initials}</span>
        )
      }
    </span>
    <span class="modelo-builder-card__body">
      <h2>{builder.name}</h2>
      {builder.address && <p class="modelo-card__place">{builder.address}</p>}
      <p class="modelo-card__price modelo-builder-card__stock">
        <span>Unidades à venda</span>
        <strong>{stock}</strong>
      </p>
    </span>
  </a>
</li>
