---
import type { SeoMeta } from '@/lib/seo'
import type { ModeloTheme } from '@/lib/modelo-theme'

interface Props {
  seo: SeoMeta
  robots?: string
  theme?: ModeloTheme
}

const { seo, robots = 'noindex, follow', theme } = Astro.props
const fontHref = 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Outfit:wght@400;500;600&display=swap'
const jsonLd = seo.jsonLd ? (Array.isArray(seo.jsonLd) ? seo.jsonLd : [seo.jsonLd]) : []
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={seo.canonical} />
    <meta property="og:type" content={seo.ogType} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {seo.ogImage && <meta name="twitter:image" content={seo.ogImage} />}
    {
      theme && (
        <link
          rel="stylesheet"
          href={fontHref}
        />
      )
    }
    <link rel="stylesheet" href="/css/modelo.css?v=10" />
    {theme && <link rel="stylesheet" href="/css/modelo-themes.css?v=5" />}
    {jsonLd.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
  </head>
  <body class:list={['modelo', theme && `theme-${theme}`]}>
    <a class="modelo-skip" href="#conteudo">Ir para o conteúdo</a>
    <slot name="header" />
    <main id="conteudo" class="modelo-main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
