---
import ModeloFooter from '@/components/modelo/ModeloFooter.astro'
import ModeloHeader from '@/components/modelo/ModeloHeader.astro'
import ModeloUnits from '@/components/modelo/ModeloUnits.astro'
import ModeloLayout from '@/layouts/ModeloLayout.astro'
import {
  PublicApiError,
  browserApiUrl,
  getBuildingBySlug,
  listBuildingMedia,
  listBuildings,
  type PublicBuildingDetail,
  type PublicBuildingListItem,
  type PublicBuildingMedia,
} from '@/lib/api'
import {
  bedroomOptions,
  browserMediaUrl,
  buildingFacts,
  descriptionParagraphs,
  distinctAmenities,
  formatBrl,
  formatPlace,
  lowestPrice,
  normalizeUnit,
  parseDetailQuery,
  visibleColumns,
} from '@/lib/modelo'
import { modeloBuildingSeo, modeloMessageSeo } from '@/lib/modelo-seo'

const slug = Astro.params.slug
let detail: PublicBuildingDetail | null = null
let listItem: PublicBuildingListItem | null = null
let media: PublicBuildingMedia[] | null = null
let notFound = !slug
let loadError = false

if (slug) {
  const [detailResult, listResult, mediaResult] = await Promise.allSettled([
    getBuildingBySlug(slug),
    listBuildings(),
    listBuildingMedia(slug),
  ])

  if (detailResult.status === 'fulfilled') {
    detail = detailResult.value
  } else if (detailResult.reason instanceof PublicApiError && detailResult.reason.status === 404) {
    notFound = true
  } else {
    loadError = true
  }

  if (listResult.status === 'fulfilled' && detail) {
    listItem = listResult.value.find((item) => item.slug === detail?.slug) ?? null
  }

  if (mediaResult.status === 'fulfilled') {
    media = mediaResult.value
  }
}

const listHref = listBackHref(Astro.request)
const companyHref = companyBackHref(Astro.request)
const backHref = companyHref ?? listHref
const backLabel = companyHref ? 'Empreendimentos' : 'Lançamentos'
const query = parseDetailQuery(Astro.url.searchParams)

if (notFound) {
  Astro.response.status = 404
}

if (loadError) {
  Astro.response.status = 503
}

const units = (detail?.units ?? []).map((unit, index) => normalizeUnit(unit, index))
const facts = buildingFacts(units)
const paragraphs = descriptionParagraphs(detail?.description)
const amenityNames = distinctAmenities(units)
const coverPath = detail?.cover_image?.url ?? listItem?.cover_image?.url ?? null
const coverUrl = coverPath ? browserMediaUrl(coverPath) : null
const photos =
  media !== null
    ? media.flatMap((item) =>
        item.mime_type.startsWith('image/') && item.url ? [browserMediaUrl(item.url)] : [],
      )
    : coverUrl
      ? [coverUrl]
      : []
const place = formatPlace(detail?.city, detail?.state)
const builder = detail?.builder ?? listItem?.builder ?? null
const fromPrice = lowestPrice(units)
const hasOverview = paragraphs.length > 0 || facts.length > 0 || photos.length > 0
const toc = [
  hasOverview ? { href: '#visao-geral', label: 'Visão geral' } : null,
  { href: '#unidades', label: 'Unidades' },
  amenityNames.length > 0 ? { href: '#diferenciais', label: 'Diferenciais' } : null,
].filter((item): item is { href: string; label: string } => item !== null)

const seo = detail
  ? modeloBuildingSeo(detail, Astro.url)
  : modeloMessageSeo(
      Astro.url,
      notFound ? 'Lançamento não encontrado' : 'Não foi possível carregar os lançamentos.',
      notFound
        ? 'Este endereço não corresponde a um empreendimento publicado.'
        : 'Não foi possível carregar os lançamentos.',
    )

if (detail && (photos[0] ?? coverUrl)) {
  seo.ogImage = photos[0] ?? coverUrl
}

const path = detail ? `/modelo/empreendimentos/${encodeURIComponent(detail.slug)}` : '/modelo'

function listBackHref(request: Request): string {
  const referer = request.headers.get('referer')

  if (!referer) {
    return '/modelo#lancamentos'
  }

  try {
    const url = new URL(referer)

    if (url.pathname === '/modelo') {
      return `/modelo${url.search}#lancamentos`
    }
  } catch {
    return '/modelo#lancamentos'
  }

  return '/modelo#lancamentos'
}

function companyBackHref(request: Request): string | null {
  const referer = request.headers.get('referer')

  if (!referer) {
    return null
  }

  try {
    const match = new URL(referer).pathname.match(/^\/modelo\/construtoras\/([a-z0-9]+(?:-[a-z0-9]+)*)\/?$/)

    return match ? `/modelo/construtoras/${match[1]}` : null
  } catch {
    return null
  }
}
---

<ModeloLayout seo={seo}>
  <ModeloHeader slot="header" lancamentosHref={listHref} restoreList />
  {
    notFound ? (
      <section class="modelo-message modelo-wrap">
        <h1>Lançamento não encontrado.</h1>
        <p>Este endereço não corresponde a um empreendimento publicado.</p>
        <a class="modelo-button" href="/modelo">Lançamentos</a>
      </section>
    ) : loadError || !detail ? (
      <section class="modelo-message modelo-wrap">
        <h1>Não foi possível carregar os lançamentos.</h1>
        <button type="button" class="modelo-button" data-retry>
          Tentar de novo
        </button>
      </section>
    ) : (
      <>
        <article class="modelo-building modelo-wrap modelo-wrap--wide" data-modelo-building data-building-slug={detail.slug}>
          <a class="modelo-back" href={backHref} data-modelo-back={companyHref ? undefined : true}>{backLabel}</a>
          <header>
            <h1>{detail.name}</h1>
            {place && <p class="modelo-place">{place}</p>}
            {
              builder?.name && (
                <p class="modelo-builder">
                  <span>Comercializado por</span> {builder.name}
                </p>
              )
            }
            {
              builder?.name && (
                <button type="button" class="modelo-button modelo-button--wrap" data-contact-open>
                  Solicitar acesso para comercializar esse empreendimento
                </button>
              )
            }
          </header>
          <nav class="modelo-anchors" data-modelo-toc aria-label="Nesta página">
            {toc.map((item, index) => (
              <a href={item.href} aria-current={index === 0 ? 'location' : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
          <div class="modelo-sheet">
            <aside class="modelo-toc" data-modelo-toc aria-label="Nesta página">
              {toc.map((item, index) => (
                <a href={item.href} aria-current={index === 0 ? 'location' : undefined}>
                  {item.label}
                </a>
              ))}
            </aside>
            <div>
              {
                hasOverview && (
                  <section id="visao-geral" class="modelo-section">
                    <h2>Visão geral</h2>
                    {paragraphs.length > 0 && (
                      <div class="modelo-prose">
                        {paragraphs.map((paragraph) => (
                          <p>{paragraph}</p>
                        ))}
                      </div>
                    )}
                    {facts.length > 0 && (
                      <dl class="modelo-facts">
                        {facts.map((fact) => (
                          <div>
                            <dt>{fact.label}</dt>
                            <dd>{fact.value}</dd>
                          </div>
                        ))}
                      </dl>
                    )}
                    {photos.length > 0 && (
                      <ul class="modelo-gallery">
                        {photos.map((url, index) => (
                          <li>
                            <button
                              type="button"
                              data-lightbox-open
                              data-caption={`Foto ${index + 1} de ${photos.length}`}
                              aria-label={`Ampliar foto ${index + 1} de ${photos.length}`}
                            >
                              <img src={url} alt="" width="480" height="480" loading="lazy" />
                            </button>
                          </li>
                        ))}
                      </ul>
                    )}
                  </section>
                )
              }

              <section id="unidades" class="modelo-section">
                <h2>Unidades à venda</h2>
                {
                  units.length > 0 ? (
                    <ModeloUnits
                      units={units}
                      columns={visibleColumns(units)}
                      query={query}
                      path={path}
                      bedroomChoices={bedroomOptions(units)}
                      amenityNames={amenityNames}
                      hasFloor={units.some((unit) => unit.floor != null)}
                      hasPrice={units.some((unit) => unit.price != null)}
                    />
                  ) : (
                    <p>Nenhuma unidade publicada neste empreendimento.</p>
                  )
                }
              </section>

              {
                amenityNames.length > 0 && (
                  <section id="diferenciais" class="modelo-section">
                    <h2>Diferenciais</h2>
                    <ul class="modelo-differentials">
                      {amenityNames.map((name) => (
                        <li>{name}</li>
                      ))}
                    </ul>
                  </section>
                )
              }

              <section class="modelo-close" aria-label="Contato">
                <p class="modelo-close__name">{detail.name}</p>
                {
                  fromPrice != null ? (
                    <p class="modelo-close__price">
                      A partir de <strong>{formatBrl(fromPrice)}</strong>
                    </p>
                  ) : (
                    <p class="modelo-close__price">Valor sob consulta</p>
                  )
                }
                {
                  builder?.name && (
                    <button type="button" class="modelo-button modelo-button--wrap" data-contact-open>
                      Solicitar acesso para comercializar esse empreendimento
                    </button>
                  )
                }
              </section>
            </div>
          </div>
        </article>

        <div class="modelo-compare-bar" data-compare-bar hidden>
          <ul data-compare-picks />
          <button type="button" class="modelo-button" data-compare-open hidden>Ver comparação</button>
          <p data-compare-limit hidden>Compare até 3 unidades.</p>
        </div>

        <dialog class="modelo-panel" data-compare-dialog aria-labelledby="comparacao-titulo">
          <div class="modelo-panel__head">
            <h2 id="comparacao-titulo">Comparação</h2>
            <button type="button" class="modelo-button modelo-button--quiet" data-close>Fechar</button>
          </div>
          <div data-compare-mount />
        </dialog>

        {
          photos.length > 0 && (
            <dialog class="modelo-lightbox" data-lightbox aria-label={`Fotos de ${detail.name}`}>
              <div class="modelo-lightbox__head">
                <p data-lightbox-caption>{detail.name}</p>
                <button type="button" class="modelo-button modelo-button--quiet" data-close>Fechar</button>
              </div>
              <img alt="" />
            </dialog>
          )
        }

        {
          builder?.name && (
            <dialog
              class="modelo-panel modelo-panel--center modelo-contact"
              data-contact
              data-login-url={browserApiUrl('/auth/login')}
              data-register-url={browserApiUrl(`/public/buildings/${encodeURIComponent(detail.slug)}/broker-account`)}
              data-request-url={browserApiUrl(`/broker/buildings/${encodeURIComponent(detail.slug)}/access-requests`)}
              data-me-url={browserApiUrl('/auth/me')}
              data-handoff-url={browserApiUrl('/auth/handoff')}
              aria-labelledby="contato-titulo"
            >
              <div class="modelo-panel__head">
                <h2 id="contato-titulo">Solicitar acesso para comercializar esse empreendimento</h2>
                <button type="button" class="modelo-button modelo-button--quiet" data-close>Fechar</button>
              </div>
              <p class="modelo-contact__lead">Entre com sua conta de corretor ou crie uma para pedir este empreendimento.</p>
              <div data-access-session hidden>
                <p data-access-who></p>
                <button type="button" class="modelo-button" data-access-send>Enviar pedido</button>
              </div>
              <div data-access-auth>
                <div class="modelo-choice" role="group" aria-label="Como continuar">
                  <button type="button" data-access-mode="login" aria-pressed="true">Entrar</button>
                  <button type="button" data-access-mode="register" aria-pressed="false">Criar conta</button>
                </div>
                <form class="modelo-contact__form" data-access-login>
                  <label class="modelo-field">
                    <span>E-mail</span>
                    <input name="email" type="email" required autocomplete="username" />
                  </label>
                  <label class="modelo-field">
                    <span>Senha</span>
                    <input name="password" type="password" required autocomplete="current-password" />
                  </label>
                  <button type="submit" class="modelo-button">Entrar e pedir acesso</button>
                </form>
                <form class="modelo-contact__form" data-access-register hidden>
                  <label class="modelo-field">
                    <span>Nome</span>
                    <input name="name" type="text" required maxlength="120" autocomplete="name" />
                  </label>
                  <label class="modelo-field">
                    <span>Telefone</span>
                    <input name="phone" type="tel" required maxlength="30" autocomplete="tel" inputmode="tel" placeholder="(11) 90000-0000" />
                  </label>
                  <label class="modelo-field">
                    <span>E-mail</span>
                    <input name="email" type="email" required maxlength="255" autocomplete="email" />
                  </label>
                  <label class="modelo-field">
                    <span>Senha</span>
                    <input name="password" type="password" required minlength="8" autocomplete="new-password" />
                  </label>
                  <label class="modelo-field">
                    <span>Confirmar senha</span>
                    <input name="password_confirmation" type="password" required minlength="8" autocomplete="new-password" />
                  </label>
                  <button type="submit" class="modelo-button">Criar conta e pedir acesso</button>
                </form>
              </div>
              <p class="modelo-contact__error" data-access-error role="alert" tabindex="-1" hidden></p>
              <p class="modelo-contact__success" data-access-success role="status" tabindex="-1" hidden></p>
              <a class="modelo-button" data-access-dashboard href="http://corretor.localhost:5173/" hidden>Abrir minha área</a>
            </dialog>
          )
        }
        <iframe hidden src="http://corretor.localhost:5173/session-bridge" title="Sessão do corretor" data-session-bridge onload="this.dataset.loaded='true'"></iframe>
      </>
    )
  }
  <ModeloFooter slot="footer" />
</ModeloLayout>

<script>
  import { initModeloDetail } from '@/scripts/modelo-detail'

  initModeloDetail()
</script>
