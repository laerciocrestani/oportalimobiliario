---
import ModeloCard from '@/components/modelo/ModeloCard.astro'
import ModeloFooter from '@/components/modelo/ModeloFooter.astro'
import ModeloHeader from '@/components/modelo/ModeloHeader.astro'
import ModeloHomeHero from '@/components/modelo/ModeloHomeHero.astro'
import ModeloHomeStory from '@/components/modelo/ModeloHomeStory.astro'
import ModeloLayout from '@/layouts/ModeloLayout.astro'
import { listBuildings, type PublicBuildingListItem } from '@/lib/api'
import {
  browserMediaUrl,
  compareHome,
  fold,
  formatBrl,
  formatPlace,
  launchCount,
  listPrice,
  matchesCity,
  matchesPrice,
  parseHomeQuery,
  toHomeSearch,
  uniqueCities,
  type HomeQuery,
} from '@/lib/modelo'
import { withExemploListing } from '@/lib/modelo-exemplo'
import { modeloHomeSeo, modeloMessageSeo } from '@/lib/modelo-seo'
import { withModeloTheme, type ModeloTheme } from '@/lib/modelo-theme'

let buildings: PublicBuildingListItem[] = []
let loadError = false

try {
  buildings = await listBuildings()
} catch {
  loadError = true
}

const apiBuildings = buildings

if (!loadError) {
  buildings = withExemploListing(buildings)
}

const query: HomeQuery = parseHomeQuery(Astro.url.searchParams)
const theme: ModeloTheme = 'luxo'
const cardQuery = ''
const cities = uniqueCities(buildings.map((building) => building.city))
const builders = [
  ...new Set(
    buildings
      .map((building) => building.builder?.name?.trim())
      .filter((name): name is string => Boolean(name)),
  ),
]
const unitTotal = buildings.reduce((sum, building) => sum + building.units_count, 0)
const stats = [
  { label: 'Lançamentos', value: buildings.length },
  { label: 'Cidades', value: cities.length },
  { label: 'Unidades', value: unitTotal },
  { label: 'Construtoras', value: builders.length },
].filter((item) => item.value > 0 || item.label === 'Lançamentos')
const hasPrice = buildings.some((building) => listPrice(building) != null)
const indexed = buildings.map((building, index) => ({
  building,
  record: {
    index,
    name: building.name,
    city: building.city,
    price: listPrice(building),
  },
}))
const ordered = [...indexed].sort((a, b) => compareHome(a.record, b.record, query.ordem))
const visibleCount = ordered.filter(
  (item) => matchesCity(item.record.city, query.cidade) && matchesPrice(item.record.price, query.ate),
).length
const heroSource = apiBuildings.find((building) => building.cover_image?.url)
const heroUrl = heroSource?.cover_image?.url ? browserMediaUrl(heroSource.cover_image.url) : '/modelo/hero.jpg?v=3'
const financeValue = ordered.find((item) => item.record.price != null)?.record.price ?? 0
const citiesJson = JSON.stringify(cities).replace(/</g, '\\u003c')
const homePath = withModeloTheme('/modelo')
const cityCards = cities.map((city) => {
  const sample = buildings.find((building) => fold(building.city ?? '') === fold(city) && building.cover_image?.url)

  return {
    city,
    href: homeHref({ ...query, cidade: city }),
    count: buildings.filter((building) => fold(building.city ?? '') === fold(city)).length,
    image: sample?.cover_image?.url ? browserMediaUrl(sample.cover_image.url) : null,
  }
})
const storySource = [
  ...buildings.filter((building) => building.description?.trim()),
  ...buildings.filter((building) => !building.description?.trim()),
].slice(0, 3)
const stories = storySource.map((building) => ({
  name: building.name,
  href: `/modelo/empreendimentos/${encodeURIComponent(building.slug)}${cardQuery ? `?${cardQuery}` : ''}`,
  place: formatPlace(building.city, building.state),
  text: building.description?.trim() || 'Empreendimento publicado no portal.',
  image: building.cover_image?.url ? browserMediaUrl(building.cover_image.url) : null,
}))
const seo = loadError
  ? modeloMessageSeo(
      Astro.url,
      'Não foi possível carregar os lançamentos.',
      'Não foi possível carregar os lançamentos.',
    )
  : modeloHomeSeo(Astro.url)

if (loadError) {
  Astro.response.status = 503
}

function homeHref(next: HomeQuery): string {
  const search = toHomeSearch(next)

  return search ? `/modelo${search}` : '/modelo'
}
---

<ModeloLayout seo={seo} theme={theme}>
  <ModeloHeader
    slot="header"
    homeHref={homePath}
    lancamentosHref={buildings.length > 0 && !loadError ? '#lancamentos' : homePath}
  />
  {
    loadError ? (
      <section class="modelo-message modelo-wrap">
        <h1>Não foi possível carregar os lançamentos.</h1>
        <button type="button" class="modelo-button" data-retry>Tentar de novo</button>
      </section>
    ) : buildings.length === 0 ? (
      <section class="modelo-hero">
        <div class="modelo-wrap">
          <div class="modelo-hero__panel">
            <p class="modelo-kicker">Lançamentos</p>
            <h1>Nenhum lançamento publicado no momento.</h1>
          </div>
        </div>
      </section>
    ) : (
      <div data-modelo-home class="theme-home">
        <ModeloHomeHero
          query={query}
          cities={cities}
          heroUrl={heroUrl}
          cityHref={(city) => homeHref({ ...query, cidade: city })}
        />
        <div class="theme-market">
          <div class="theme-market__list">
            <div class="modelo-refine">
              <div class="modelo-wrap modelo-refine__inner">
                <p class="modelo-count" data-modelo-count aria-live="polite">{launchCount(visibleCount)}</p>
                <ul class="modelo-chips" data-modelo-chips>
                  {
                    query.cidade && (
                      <li class="modelo-chip">
                        <span>{query.cidade}</span>
                        <a href={homeHref({ ...query, cidade: '' })} aria-label={`Remover filtro de cidade ${query.cidade}`}>
                          Remover
                        </a>
                      </li>
                    )
                  }
                  {
                    query.ate != null && (
                      <li class="modelo-chip">
                        <span>Preço até {formatBrl(query.ate)}</span>
                        <a href={homeHref({ ...query, ate: null })} aria-label="Remover filtro de preço">Remover</a>
                      </li>
                    )
                  }
                </ul>
                {
                  hasPrice && (
                    <label class="modelo-field modelo-price">
                      <span>Preço até</span>
                      <input form="modelo-busca" name="ate" inputmode="numeric" value={query.ate ?? ''} autocomplete="off" />
                    </label>
                  )
                }
                <label class="modelo-sort">
                  <span>Ordenar por</span>
                  <select form="modelo-busca" name="ordem" data-modelo-sort onchange="this.form.requestSubmit()">
                    <option value="relevancia" selected={query.ordem === 'relevancia'}>Relevância</option>
                    <option value="menor-preco" selected={query.ordem === 'menor-preco'}>Menor preço</option>
                    <option value="maior-preco" selected={query.ordem === 'maior-preco'}>Maior preço</option>
                    <option value="nome" selected={query.ordem === 'nome'}>Nome</option>
                  </select>
                </label>
              </div>
            </div>
            <section id="lancamentos" class="modelo-listings" tabindex="-1" aria-labelledby="lancamentos-titulo">
              <div class="modelo-wrap">
                <h2 id="lancamentos-titulo" class="theme-display">Lançamentos</h2>
                <ul class="modelo-grid" data-modelo-grid hidden={visibleCount === 0}>
                  {
                    ordered.map((item) => (
                      <ModeloCard
                        building={item.building}
                        index={item.record.index}
                        query={cardQuery}
                        hidden={!matchesCity(item.record.city, query.cidade) || !matchesPrice(item.record.price, query.ate)}
                      />
                    ))
                  }
                </ul>
                <div class="modelo-empty" data-modelo-empty hidden={visibleCount !== 0}>
                  <p>Nenhum lançamento com esses critérios.</p>
                  <a class="modelo-button" href={homeHref({ cidade: '', ate: null, ordem: 'relevancia' })}>Limpar filtros</a>
                </div>
              </div>
            </section>
          </div>
        </div>
        <ModeloHomeStory
          theme={theme}
          stats={stats}
          cities={cityCards}
          builders={builders}
          stories={stories}
          financeValue={financeValue}
        />
        <script type="application/json" id="modelo-cities" is:inline set:html={citiesJson} />
      </div>
    )
  }
  <ModeloFooter slot="footer" />
</ModeloLayout>

<script>
  import { initModeloHome } from '@/scripts/modelo-home'
  import { initModeloThemes } from '@/scripts/modelo-themes'

  initModeloHome()
  initModeloThemes()
</script>
